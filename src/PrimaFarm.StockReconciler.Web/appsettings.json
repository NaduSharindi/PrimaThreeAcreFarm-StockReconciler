{
  "ConnectionStrings": {
    "StockDb": "Server=(localdb)\\MSSQLLocalDB;Database=PrimaFarmStockDb;Trusted_Connection=True;TrustServerCertificate=True;Application Name=PrimaFarm.StockReconciler"
  },
  "Database": {
    "AutoDeploy": false
  },
  "Security": {
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "SessionTimeoutMinutes": 30,
    "MaxUploadBytes": 10485760
  },
  "ApiClients": {
    "Clients": {}
  },
  "Integration": {
    "Finance": {
      "BaseUrl": "https://finance.example.internal/",
      "ApiKey": "",
      "TimeoutSeconds": 30
    }
  },
  "MockFinance": {
    "Enabled": false,
    "ApiKey": "",
    "TransientFailureRate": 0.0
  },
  "DataProtection": {
    "KeyPath": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/prima-stock-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{CorrelationId}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
