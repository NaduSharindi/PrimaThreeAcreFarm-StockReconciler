<?xml version="1.0" encoding="utf-8"?>
<!-- IIS hosting configuration (requires the ASP.NET Core Hosting Bundle on the server). -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\PrimaFarm.StockReconciler.Web.dll"
                  stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!-- Secrets are NOT stored here. Set ConnectionStrings__StockDb and Integration__Finance__ApiKey
               as IIS application-pool environment variables or in a secured machine-level store. -->
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering removeServerHeader="true">
          <!-- 40 MB: one ERP file + three farm files -->
          <requestLimits maxAllowedContentLength="41943040" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
