@model string
@{
    ViewData["Title"] = "Error";
    ViewData["Tagline"] = "Something went wrong.";
}
<section class="card" aria-label="Error">
    <h2>We could not complete that request</h2>
    <p class="hint">
        The error has been logged. If it keeps happening, contact the IT service desk and quote this reference:
    </p>
    <p><code class="ref">@Model</code></p>
    <a class="btn btn-secondary" asp-controller="Dashboard" asp-action="Index">Back to dashboard</a>
</section>
